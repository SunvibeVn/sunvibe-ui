# Public URL of this site, used for absolute links in share previews (Open Graph).
NEXT_PUBLIC_SITE_URL=https://sunvibe.vn

# sunvibe-server base URL; every backend module answers on it.
# Server-side only: never prefix it with NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8081

# Browser-visible origin of the public API (ADR-008); the owner intake form calls it directly.
NEXT_PUBLIC_API_URL=http://localhost:8081

# What the build shows of the phone channel: off, legacy-login or on (any other value reads as off). Inlined at build
# time, so it must match AUTH_PHONE_MODE of the API it talks to; it only shows or hides, the API decides.
NEXT_PUBLIC_AUTH_PHONE_MODE=off

# Turns on the public owner intake page /list-with-us (BR-15, C-7, Q-11); any value other than "true" makes it a 404.
# Inlined at build time. Keep it off in production until the staff queue UI exists and the consent text passed legal review.
# Set it to true only in your own .env.local for local testing (npm run e2e sets it itself).
NEXT_PUBLIC_OWNER_INTAKE_ENABLED=false
