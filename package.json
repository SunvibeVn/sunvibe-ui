{
  "name": "sunvibe-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../sunvibe-server/api/openapi.json -o src/api/generated/schema.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --fix"
  }
}
